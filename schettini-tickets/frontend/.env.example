# URL del backend API (requerido para producción)
# En local (localhost), se usa http://localhost:5050 automáticamente.
# En producción, definir la URL real del backend (ej. https://api.sch-soporte.com.ar)
REACT_APP_API_URL=https://api.sch-soporte.com.ar

# Tema festivo Argentina · Mundial 2026 (temporal: 1 may – 20 jul 2026)
# Si no se define, el tema se activa/desactiva solo por fechas del navegador.
# true  → forzar tema ON (útil para pruebas)
# false → forzar tema OFF (útil fuera del período o rollback inmediato)
# REACT_APP_WORLD_CUP_THEME=true
